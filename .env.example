# RUNTIME PATHS (never hardcode these in code — read via os.getenv/os.environ)
VAULT_PATH=/path/to/AI_Employee_Vault
PYTHON_EXEC=/path/to/venv/bin/python3

# TIER RUNTIME SELECTION (Silver / Gold)
CURRENT_SYSTEM_TIER=Gold

# ZONE SAFETY GATE — "cloud" = draft-only/sandbox (Cloud VM zone), "local" =
# live send/post/cancel allowed (Local Zone only). Defaults to "cloud" (safe)
# if missing/unset/any other value. Set explicitly per machine:
#   Cloud VM:        EXECUTION_ZONE=cloud
#   Local Zone (you): EXECUTION_ZONE=local
EXECUTION_ZONE=cloud

# CORE RUNTIME CONFIGS
MAX_AUTONOMOUS_LOOPS=10
RALPH_WIGGUM_RETRY_LIMIT=3
AUDIT_LOG_ROTATION_DAYS=30

# CROSS-DOMAIN CONFIGS (Personal + Business Separation)
PERSONAL_EMAIL_ALERTS=your_personal_email@domain.com
BUSINESS_EMAIL_ALERTS=operations@yourbusiness.com

ODOO_URL="https://your-instance.odoo.com"
ODOO_DB="your-db"
ODOO_USER="you@example.com"
ODOO_API_KEY="your-odoo-api-key"

# CRYPTOGRAPHY KEYS (32-Character random string)
SECRET_ENCRYPTION_KEY="replace-with-32-character-secret-key"

# TWITTER (X) API CONFIGS
TWITTER_BEARER_TOKEN="your-twitter-bearer-token-if-any"
TWITTER_API_KEY="your-api-key"
TWITTER_API_SECRET="your-api-secret"
TWITTER_ACCESS_TOKEN="your-access-token"
TWITTER_ACCESS_TOKEN_SECRET="your-access-secret"

# META (FACEBOOK & INSTAGRAM) API CONFIGS
META_PAGE_ID="your-facebook-page-id-if-any"
META_PAGE_ACCESS_TOKEN="your-page-access-token"
INSTAGRAM_BUSINESS_ACCOUNT_ID="your-instagram-business-id"

# WHATSAPP BUSINESS CLOUD API (web_gui/app.py webhook, Task 1)
# VERIFY_TOKEN: any string you choose, entered in the Meta App Dashboard's
#   webhook setup screen (GET handshake).
# APP_SECRET: from Meta App Dashboard -> App Settings -> Basic -> App Secret.
#   Required so the POST webhook can verify each payload's X-Hub-Signature-256
#   HMAC and reject spoofed/injected messages -- if left unset, the webhook
#   still works but payload signatures are NOT verified (logged as a warning
#   every time). Set this before exposing the webhook to real traffic.
WHATSAPP_VERIFY_TOKEN="choose-any-random-string"
WHATSAPP_APP_SECRET="your-meta-app-secret"

# WHATSAPP-BASED APPROVAL (Phase 8, client-requested 2026-08-19)
# APPROVER_NUMBER: the WhatsApp number (digits only, country code, no +,
#   e.g. 923001234567) of the person allowed to Approve/Reject Pending_Approval
#   items by replying "APPROVE <code>" / "REJECT <code> <reason>" to the
#   notification pending_approval_notifier.py sends. This is the ONLY
#   authorization check for that reply -- combined with WHATSAPP_APP_SECRET's
#   signature verification above, a message from this exact number is treated
#   as equivalent to a Local-zone dashboard click. Leave unset to disable this
#   feature entirely (no notifications sent, replies ignored).
# Uses the same WHATSAPP_CLOUD_API_TOKEN / WHATSAPP_PHONE_NUMBER_ID above for
#   sending -- no separate outbound credential needed.
WHATSAPP_APPROVER_NUMBER="923001234567"

# WHITE-LABEL BRANDING (Phase 7/9) -- shown across the Web GUI (top bar,
# sidebar, login page, browser tab, About page). Purely cosmetic, no code
# change needed per client -- edit via the Setup Wizard once logged in.
# BRAND_NAME: product name shown everywhere. Defaults to "AI Employee" if unset.
# CLIENT_NAME / CLIENT_ABOUT: the reseller's own client's business name and a
#   short intro paragraph, shown on the About page so the client recognizes
#   their own business inside the dashboard. Leave blank to show a
#   "not filled in yet" placeholder there instead.
BRAND_NAME="NAADVION AI Employee"
CLIENT_NAME=""
CLIENT_ABOUT=""
